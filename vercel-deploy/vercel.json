{
  "buildCommand": null,
  "outputDirectory": ".",
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://darsak-backend.fly.dev; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/pages/downloads", "destination": "/pages/downloads.html" },
    { "source": "/pages/privacy", "destination": "/pages/privacy.html" },
    { "source": "/pages/terms", "destination": "/pages/terms.html" },
    { "source": "/pages/refund-policy", "destination": "/pages/refund-policy.html" },
    { "source": "/pages/faq", "destination": "/pages/faq.html" },
    { "source": "/pages/pricing", "destination": "/pages/pricing.html" },
    { "source": "/pages/contact", "destination": "/pages/contact.html" },
    { "source": "/:path*", "destination": "/:path*" }
  ]
}
